---
import { process } from "../data/content";
import { ta } from "../lib/i18n";
---

<section id="proceso" class="relative px-[clamp(18px,5vw,48px)] py-[clamp(52px,7vh,92px)]">
  <div class="mx-auto max-w-[1180px]">
    <div class="max-w-[680px]">
      <span class="eyebrow reveal" {...ta(process.eyebrow)}>{process.eyebrow.es}</span>
      <h2 class="display reveal mt-4 text-[clamp(34px,4.4vw,58px)]" style="--d:80ms" {...ta(process.title)}>
        {process.title.es}
      </h2>
    </div>

    <div class="relative mt-14 grid gap-10 md:grid-cols-3">
      <!-- Hilo que une los tres pasos -->
      <div
        class="pointer-events-none absolute top-7 right-0 left-0 hidden h-px md:block"
        style="background:linear-gradient(90deg, transparent, rgb(59 130 246/.4), rgb(6 214 245/.4), transparent)"
      >
      </div>

      {
        process.steps.map((s, i) => (
          <div class="reveal relative" style={`--d:${i * 120}ms`}>
            <div class="relative mb-5 flex items-center gap-4">
              <span
                class="glass flex h-14 w-14 flex-none items-center justify-center !rounded-2xl"
                style="background:linear-gradient(140deg, rgb(59 130 246/.18), rgb(6 214 245/.08))"
              >
                <span class="display gradtext text-[24px] not-italic">{s.n}</span>
              </span>
            </div>
            <h3 class="display text-[25px]" {...ta(s.title)}>
              {s.title.es}
            </h3>
            <p class="mt-2.5 text-[15px] leading-[1.6] text-muted" {...ta(s.body)}>
              {s.body.es}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
