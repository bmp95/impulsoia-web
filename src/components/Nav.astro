---
import { nav, hero, BRAND } from "../data/content";
import { ta, wa } from "../lib/i18n";
import Icon from "./Icon.astro";
---

<nav
  data-nav
  class="fixed inset-x-0 top-0 z-60 border-b border-transparent transition-[background,border-color,backdrop-filter] duration-400"
>
  <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-5 px-[clamp(18px,5vw,48px)] py-4">
    <a href="#top" class="flex flex-none items-center gap-3 text-ink no-underline">
      <img src="/img/logo.svg" alt="" width="38" height="30" class="h-[25px] w-auto sm:h-[30px]" />
      <span class="display text-[18px] whitespace-nowrap sm:text-[21px]">
        Impulso <span class="gradtext">IA</span>
      </span>
    </a>

    <div class="hidden items-center gap-9 text-[14.5px] text-muted lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link no-underline transition-colors duration-200 hover:text-ink"
            {...ta(item.label)}
          >
            {item.label.es}
          </a>
        ))
      }
    </div>

    <div class="flex flex-none items-center gap-3">
      <button
        data-lang-toggle
        type="button"
        aria-label="Cambiar idioma / Switch language"
        class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 font-mono text-[12px] tracking-[0.04em] text-ink transition-colors hover:border-white/30"
      >
        <span data-lang-es class="text-accent">ES</span>
        <span class="opacity-30">/</span>
        <span data-lang-en class="opacity-45">EN</span>
      </button>

      <a
        href={wa(hero.waMsg)} data-track="whatsapp-directo"
        class="btn btn-primary hidden !px-5 !py-2.5 !text-[14px] sm:inline-flex"
      >
        <Icon name="whatsapp" size={16} />
        <span {...ta({ es: "Hablemos", en: "Let's talk" })}>Hablemos</span>
      </a>

      <button
        data-menu-toggle
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-white/5 text-ink lg:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path data-menu-open d="M3 6h18M3 12h18M3 18h18"></path>
          <path data-menu-close class="hidden" d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div data-menu class="glass mx-[clamp(12px,4vw,24px)] mb-3 hidden overflow-hidden !rounded-2xl lg:!hidden">
    <div class="flex flex-col p-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-menu-link
            class="rounded-xl px-4 py-3 text-[15px] text-dim no-underline transition-colors hover:bg-white/6 hover:text-ink"
            {...ta(item.label)}
          >
            {item.label.es}
          </a>
        ))
      }
      <a href={wa(hero.waMsg)} data-track="whatsapp-directo" class="btn btn-primary mt-2 !py-3">
        <Icon name="whatsapp" size={16} />
        <span {...ta({ es: "Hablemos por WhatsApp", en: "Chat on WhatsApp" })}>
          Hablemos por WhatsApp
        </span>
      </a>
    </div>
  </div>
</nav>
