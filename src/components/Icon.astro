---
import { LUCIDE } from "../lib/icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls = "" } = Astro.props;

// Iconos propios: los que Lucide no cubre o que preferimos dibujar nosotros.
// El de WhatsApp es una burbuja estilizada, no el logotipo oficial de la marca.
const CUSTOM: Record<string, string> = {
  whatsapp:
    '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
};

const body = CUSTOM[name] ?? LUCIDE[name] ?? "";
if (!body && import.meta.env.DEV) console.warn(`[Icon] no existe "${name}"`);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={body}
/>
